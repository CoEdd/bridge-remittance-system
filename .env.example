# Copy this file to .env and edit it. Every value below is also the built-in default,
# so the scripted demo runs without a .env file.

# Anthropic API key. Needed only when AGENT_MODE=live; leave empty for the scripted demo.
ANTHROPIC_API_KEY=

# Claude model used in live mode. Leave empty for the default, claude-opus-5-5.
LLM_MODEL=

# Who drives the agent: "scripted" (fixed demo driver, no internet or key) or "live" (Claude).
AGENT_MODE=scripted

# Fixed business date for due dates, the planner and transaction history (YYYY-MM-DD).
DEMO_TODAY=2026-10-15

# Six-digit one-time code that Tier 3 approvals ask for. Shown on screen in the demo.
DEMO_OTP=246810

# Seconds a first payment to a new payee must wait before it can run.
COOLING_OFF_SECONDS=60

# "true" skips the Frankfurter API and uses the seeded exchange-rate snapshot.
FX_OFFLINE=false

# SQLite database location. In Docker this path sits on the bridge-data volume.
DATABASE_URL=sqlite:///./data/bridge.db

# Backend address the browser calls. Read when the frontend image is built.
NEXT_PUBLIC_API_URL=http://localhost:8000
